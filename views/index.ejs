<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Book Tracker</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>My Book Tracker</h1>

    <% if (message) { %>
        <p><%= message %></p>

    <% } %>

    <!-- Section for adding a new book -->
    <section>
        <!-- Provide a form for adding a new book and its personal tracking information. -->
    <form action="/add" method="post">
        <label for="title">Book Title:</label>
        <input type="text" id="title" name="title">

        <label for="isbn">ISBN:</label>
        <input type="text" id="isbn" name="isbn">

        <label for="rating">Rating:</label>
        <input type="number" id="rating" name="rating" min="1" max="5">

        <label for="review">Review:</label>
        <textarea id="review" name="review"></textarea>

        <label for="numberOfReads">Number of Reads:</label>
        <input type="number" id="numberOfReads" name="numberOfReads" min="0">

        <label for="numberOfListens">Number of Listens:</label>
        <input type="number" id="numberOfListens" name="numberOfListens" min="0">

        <button type="submit">Add Book</button>
    </form>
    </section>
    
    <!-- Section for sorting books -->
    <section>
        <!-- Provide a form for choosing how the books should be sorted.  -->
    <form action="/sort" method="get">
        <label for="sort">Sort by:</label>

        <select id="sort" name="sort">
            <option value="title">Title</option>
            <option value="rating">Rating</option>
            <option value="publication_year">Publication Year</option>
            <option value="number_of_reads">Number of Reads</option>
            <option value="number_of_listens">Number of Listens</option>
        </select>

        <button type="submit">Sort</button>
    </form>
    </section>

    <!-- Section for displaying saved books -->
    <section>
        <!-- Display each book's information and provide an option to edit and delete it. -->
     <% for (let book of books) { %>
        <h2><%= book.title %></h2>
        <p><%= book.author %> </p>
        <p>Rating: <%= book.rating %></p>
        <p>Number of Reads: <%= book.number_of_reads %></p>
        <p>Number of Listens: <%= book.number_of_listens %></p>

    <!-- Display the book cover using the cover URL saved in the database. -->
        <img src="<%= book.book_cover %>" alt="<%= book.title %> cover">
    </section>

    <!-- Section for displaying saved books and their edit/delete actions -->
    <section>
        <!-- Provide Edit and Delete actions for each book -->
    <form action="/edit" method="post">
        <input type="hidden" name="id" value="<%= book.id %>">
        <button>Edit</button>
    </form>

    <form action="/delete" method="post">
        <input type="hidden" name="id" value="<%= book.id %>">
        <button>Delete</button>
    </form>
    <% } %>
    </section>
    
    <script>
        // Remove the message from the URL after the page has loaded.
        if (window.location.search) {
            window.history.replaceState({}, document.title, window.location.pathname);
        }
     </script>
</body>
</html>

