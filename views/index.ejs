<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Book Tracker</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

    <div class="page-layout">
       
        <main class="main-content">
            <h1>My Book Tracker</h1>  

                <% if (typeof message !== "undefined" && message) { %>
                    <p><%= message %></p>

                <% } %>

        <details class="add-book-container">
            <summary>Add a New Book</summary>
                <!-- Section for adding a new book -->
            <section class="add-book-section">
                <!-- Provide a form for adding a new book and its personal tracking information. -->

            <form action="/add" method="post" class="add-book-form">
                <!-- Essential book information -->
                <div class="form-field">
                    <label for="title">Book Title:</label>
                    <input type="text" id="title" name="title">
                </div>
                
                <div>
                    <label for="isbn">ISBN:</label>
                    <input type="text" id="isbn" name="isbn">
                </div>

                <h3 class="tracking-heading">Your Reading Experience</h3>

                <div class="form-field">
                    <label for="readerName">Your Name:</label>
                    <input
                        type="text"
                        id="readerName"
                        name="readerName"
                        required       
                        >
                </div>

                <div>
                    <label for="rating">Rating:</label>
                <input type="number" id="rating" name="rating" min="1" max="5">
                </div>
                
                <div>
                    <label for="review">Review:</label>
                    <textarea id="review" name="review"></textarea>
                </div>

                <div>
                    <label for="numberOfReads">Number of Reads:</label>
                    <input type="number" id="numberOfReads" name="numberOfReads" min="0">
                </div>
                    
                <div>
                    <label for="numberOfListens">Number of Listens:</label>
                    <input type="number" id="numberOfListens" name="numberOfListens" min="0">
                </div>
                
                <button type="submit" class="add-book-button">Add Book</button>
            </form>
            </section>
        </details>
        

            <!-- Section for sorting books -->
        <section class="sort-section">
            <!-- Provide a form for choosing how the books should be sorted.  -->
        <form action="/sort" method="get">
            <label for="sort">Sort by:</label>

            <select id="sort" name="sort">
                <option value="title">Title</option>
                <option value="rating">Rating</option>
                <option value="publication_year">Publication Year</option>
                <option value="number_of_reads">Number of Reads</option>
                <option value="number_of_listens">Number of Listens</option>
            </select>

            <button type="submit">Sort</button>
        </form>
        </section>

        <!-- Section for displaying saved books -->
        <section class="books-section">
        <!-- Display each book's information and provide an option to edit and delete it. -->
        <% for (let book of books) { %>
            <div class="book-card">
                <!-- Book information -->
                <div class="book-details">
                    <h2 class="book-title"><%= book.title %></h2>
                    <p class="book-author"><%= book.author %> </p>

                    <p class="book-info"> <%= book.average_rating !== null
                        ? `${book.average_rating}/5`
                        : "Not rated" %>
                    </p>

                    <p class="book-info">
                        Shared by <%= book.contributor_count %>
                        <%= book.contributor_count === 1 ? "reader" : "readers" %>
                    </p>

                    <p class="book-info">
                        Total Listens: <%= book.total_listens %>
                    </p>
                </div>

            <!-- Display contributors without expanding the book card -->
             <div class="community-reviews">
                <p class="contributors-label">Contributors:</p>

                <% for (let contribution of book.contributions) { %>

                    <button
                        type="button"
                        class="contributor-link"
                        data-reader-name="<%= contribution.reader_name %>"
                        data-rating="<%= contribution.rating ?? '' %>"
                        data-review="<%= contribution.review || '' %>"
                        data-reads="<%= contribution.number_of_reads ?? 0 %>"
                        data-listens="<%= contribution.number_of_listens ?? 0 %>"
                        title="<%= contribution.review || 'View reader experience' %>"
                    >
                        <%= contribution.reader_name %>
                    </button>

                <% } %>    
             </div>

            <!-- Display the book cover using the cover URL saved in the database. -->
             <% if (book.book_cover) { %>
                <img src="<%= book.book_cover %>" alt="<%= book.title %> cover">
             <% } else { %>
            <%# Display a placeholder when no cover is available. %>
                <div class="book-cover-placeholder">
                    <span>No cover available</span>
                </div>
             <% } %>
                
             <!-- Form for uploading a custom cover image for a specific book. -->
                <form class="cover-upload-form" action="/upload-cover" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="<%= book.id %>">

                    <input 
                    type="file"
                    id="cover-<%= book.id %>"
                    name="cover"
                    accept="image/jpeg, image/png, image/webp"
                    required
                    >

                    <button type="submit">Upload</button>
                </form>

                <div class="book-actions">
                    <!-- Provide Edit and Delete actions for each book -->
                <form action="/edit" method="post">
                    <input type="hidden" name="id" value="<%= book.id %>">
                    <button>Edit</button>
                </form>

                <form action="/delete" method="post">
                    <input type="hidden" name="id" value="<%= book.id %>">
                    <button>Delete</button>
                </form>
                </div>

            </div>
            <% } %>

        </section>
    </main>
    
        <!-- Modal for displaying an individual reader's experience -->
         <div id="readerModal" class="reader-modal">

            <div class="reader-modal-content">
                <button
                    type="button"
                    id="closeReaderModal"
                    class="close-modal"
                    aria-label="Close modal"
                >
                    &times;

                </button>

                <h2 id="modalReaderName"></h2>
                <p id="modalRating"></p>
                <p id="modalReview"></p>
                <p id="modalReads"></p>
                <p id="modalListens"></p>

            </div>

         </div>

    <script>

    </script>
        
        
    
    
  
    
    <script>
        // Remove the message from the URL after the page has loaded.
        if (window.location.search) {
            window.history.replaceState({}, document.title, window.location.pathname);
        }
     </script>

     <!-- Load the frontend JavaScript file -->
    <script src="/script.js"></script>
</body>
</html>

